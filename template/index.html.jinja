<!doctype html>
{%- if theme_toggle %}
<html lang="en">
{%- else %}
<!-- Dark-only: the class is fixed. To add light mode, see `ThemeToggle` in shared-ui. -->
<html lang="en" class="dark">
{%- endif %}
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title | e }}</title>
    <!-- Shared by all sites (from web-template). The SVG for modern browsers; the ICO for the rest
         (`sizes="32x32"`, not "any", or Chrome picks the ICO over the SVG). -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Static on purpose: link previews and crawlers don't run JavaScript, so every URL shares
         these. -->
    <meta name="description" content="{{ description | e }}" />
    <link rel="canonical" href="https://{{ host }}/" />
{%- if theme_toggle %}
    <!-- The page background (`--background`), in hex. Follows the system theme, not the toggle. -->
    <meta name="theme-color" content="#f7f7f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
{%- else %}
    <!-- The page background (`--background`), in hex. -->
    <meta name="theme-color" content="#0a0a0a" />
{%- endif %}

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://{{ host }}/" />
    <meta property="og:title" content="{{ title | e }}" />
    <meta property="og:description" content="{{ description | e }}" />

    <!-- The app's og:image lines (1200 × 630, with og:image:width, og:image:height and
         og:image:alt) go below, a line away from the template's, so template updates don't
         conflict with them. cv-web and site-web render theirs from a Storybook story. -->

    <!-- Without it, Discord and X show a small thumbnail instead of the large card. -->
    <meta name="twitter:card" content="summary_large_image" />
{%- if theme_toggle %}
    <script>
      // Runs before the first paint so the page never flashes the wrong theme. The key is
      // shared-ui's THEME_STORAGE_KEY, which `ThemeToggle` writes.
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch (e) {}
        var dark =
          stored === "dark" ||
          (stored !== "light" &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        if (dark) document.documentElement.classList.add("dark");
      })();
    </script>
{%- endif %}
    <script>
      // Runs before the first paint so a visit from another site's link starts under the cover,
      // which shared-ui then slides off; a cold load is never covered, and the cover clears by
      // itself after a second if shared-ui never does. The names are shared-ui's
      // SITE_TRANSITION_ATTRIBUTE, SITE_TRANSITION_TO_ATTRIBUTE and SITE_TRANSITION_COOKIE; the
      // cookie's Domain is its `cookieDomain`.
      (function () {
        var root = document.documentElement;
        var mark = "data-site-transition";
        var clear = function () {
          root.removeAttribute(mark);
          root.removeAttribute("data-site-transition-to");
        };
        // The signal: this host's arrival cookie, deleted once read. False for none or another host's.
        var takeSignal = function () {
          var cookies = document.cookie.split("; ");
          var found = false;
          for (var i = 0; i < cookies.length; i++)
            if (cookies[i] === "site-transition=" + location.host) found = true;
          if (!found) return false;
          var host = location.hostname;
          var labels = host.split(".");
          var single = host.indexOf(":") >= 0 || /^\d+(\.\d+){3}$/.test(host) || labels.length < 2;
          document.cookie =
            "site-transition=; " +
            (single ? "" : "Domain=" + labels.slice(-2).join(".") + "; ") +
            "path=/; max-age=0; SameSite=Lax";
          return true;
        };
        // Never while it reads `leaving`: a click on another site's link within the second.
        var armClear = function () {
          setTimeout(function () {
            var state = root.getAttribute(mark);
            if (state === "covered" || state === "revealing") clear();
          }, 1000);
        };
        if (document.prerendering === true) {
          root.setAttribute(mark, "covered");
          // Registered before shared-ui's, so the mark is gone at activation when there's no signal.
          document.addEventListener(
            "prerenderingchange",
            function () {
              if (takeSignal()) armClear();
              else clear();
            },
            { once: true }
          );
        } else if (takeSignal()) {
          root.setAttribute(mark, "covered");
          armClear();
        }
      })();
    </script>
  </head>
  <body>
    <div id="app"></div>
    <script type="module" src="/src/main.tsx"></script>
  </body>
</html>
