# The site. Build files under /assets/ have a content hash in their names, so they never change:
# cached for a year. Everything else (the HTML, robots.txt, icons) revalidates, so a deploy shows
# at once.
map $uri $cache_control {
    ~^/assets/  "public, max-age=31536000, immutable";
    default     "no-cache";
}

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;
    # No nginx version in headers and error pages.
    server_tokens off;
    # nginx's own types plus `.mjs`, which it doesn't know: browsers only run a module script
    # served as JavaScript (Pyodide loads its runtime as `pyodide.mjs`).
    include /etc/nginx/mime.types;
    types {
        application/javascript mjs;
    }

    # HTML is compressed by default; these are the other compressible types the site serves.
    gzip on;
    gzip_comp_level 6;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain application/xml application/wasm;

    location / {
        add_header Cache-Control $cache_control;
{%- if csp %}
        # In each location that sets headers: a location's own `add_header` replaces the outer ones.
        include /etc/nginx/csp.conf;
{%- endif %}
        # Every page is a real file (prerendered, see `scripts/prerender.mjs`), so anything else is
        # a 404, not the home page under another URL.
        try_files $uri $uri/ =404;
    }

    # The not-found page (prerendered too), still with a 404 status.
    error_page 404 /404.html;
    location = /404.html {
        internal;
{%- if csp %}
        include /etc/nginx/csp.conf;
{%- endif %}
    }
}
