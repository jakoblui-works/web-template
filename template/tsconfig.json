{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["@testing-library/jest-dom/vitest"]
  },
  "exclude": ["eslint.config.ts", "vite.config.js", ".storybook"]
}
