{
  "name": "{{ app_name }}",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "vite --port 3000",
{%- if use_api %}
    "dev:prod": "API_PROXY_TARGET=https://jakoblui.com/api vite --port 3000",
{%- endif %}
    "build": "vite build && vite build --ssr src/prerender.tsx --outDir dist-ssr && node scripts/prerender.mjs && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "start": "vite",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
{%- if use_api %},
    "generate:api": "orval"
{%- endif %}
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@jakoblui-works/shared-ui": "^0.3.0",
    "@tailwindcss/vite": "^4.2.2",
{%- if use_api %}
    "@tanstack/react-query": "^5.104.1",
{%- endif %}
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/router-plugin": "^1.168.40",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/js": "^10.0.1",
{%- if use_api %}
    "@fast-check/vitest": "^0.5.0",
{%- endif %}
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
{%- if use_api %}
    "@tanstack/react-query-devtools": "^5.104.0",
{%- endif %}
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^5.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^10.6.0",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
{%- if use_api %}
    "orval": "^8.39.0",
{%- endif %}
    "playwright": "^1.64.1",
    "storybook": "^10.6.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.14",
    "vitest": "^5.0.1"
  }
}
