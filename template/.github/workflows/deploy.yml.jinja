name: Deploy

on:
  push:
    branches: [main]

jobs:
  test:
    uses: ./.github/workflows/ci.yml
    permissions:
      contents: read
      packages: read
  build:
    needs: test
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    steps:
      - uses: actions/checkout@v7
      - name: Log in to ghcr.io
        uses: docker/login-action@v4
        with:
          registry: ghcr.io
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
      - name: Build and push
        env:
          NODE_AUTH_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
        run: |
          docker build --secret id=npm_token,env=NODE_AUTH_TOKEN -t ghcr.io/jakoblui-works/{{ app_name }}:{% raw %}${{ github.sha }}{% endraw %} -t ghcr.io/jakoblui-works/{{ app_name }}:latest .
          docker push ghcr.io/jakoblui-works/{{ app_name }}:{% raw %}${{ github.sha }}{% endraw %}
          docker push ghcr.io/jakoblui-works/{{ app_name }}:latest
  build-storybook:
    needs: test
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    steps:
      - uses: actions/checkout@v7
      - name: Log in to ghcr.io
        uses: docker/login-action@v4
        with:
          registry: ghcr.io
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
      - name: Build and push
        env:
          NODE_AUTH_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
        run: |
          docker build -f Dockerfile.storybook --secret id=npm_token,env=NODE_AUTH_TOKEN -t ghcr.io/jakoblui-works/{{ app_name }}-storybook:{% raw %}${{ github.sha }}{% endraw %} -t ghcr.io/jakoblui-works/{{ app_name }}-storybook:latest .
          docker push ghcr.io/jakoblui-works/{{ app_name }}-storybook:{% raw %}${{ github.sha }}{% endraw %}
          docker push ghcr.io/jakoblui-works/{{ app_name }}-storybook:latest
  trigger-deploy:
    needs: [build, build-storybook]
    runs-on: ubuntu-latest
    steps:
      - name: Trigger deploy
        env:
          GH_TOKEN: {% raw %}${{ secrets.DEPLOY_REPO_DISPATCH_TOKEN }}{% endraw %}
        run: |
          gh api repos/jakoblui-works/infra/dispatches -f event_type=deploy
